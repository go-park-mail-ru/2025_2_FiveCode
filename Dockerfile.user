FROM golang:1.25-alpine AS builder
WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
COPY config/ ./config/

RUN CGO_ENABLED=0 go build -o /app/user-service ./cmd/user/main.go

FROM alpine:latest
WORKDIR /app

COPY --from=builder /app/user-service .
COPY --from=builder /app/config/ ./config/

EXPOSE 50052
CMD ["./user-service"]